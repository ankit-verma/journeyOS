# Copy this file to .env and fill in your values
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-string

# Optional — only needed if using cloud AI providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — watsonx.ai (IBM Cloud)
# Get API key : https://cloud.ibm.com/iam/apikeys
# Get Project ID: IBM watsonx.ai console → your project → Manage → Project ID
# WATSONX_API_KEY=<your-ibm-cloud-iam-api-key>
# WATSONX_PROJECT_ID=<your-watsonx-project-uuid>
# WATSONX_REGION=us-south   # options: us-south | eu-de | jp-tok
